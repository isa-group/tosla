        rdf:value tosla:guarantee;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :monthlyUptimePercentage;
            odrl:operator odrl:gteq ;
            odrl:rightOperand "99.9"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval;
            odrl:operator odrl:eq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ]; 
    ];
    tosl:liability [ 
        a tosl:Liability ;
        dcterms:description "The customer is responsible for monitoring and compiling all information regarding service unavailability in order to claim compensation.";
        rdf:value tosla:conditionEvaluation ;
        tosl:liableParty :customerEnterprisePlan 
    ] ;
    tosl:liability [ 
        a tosl:Liability ;     
        dcterms:description "The customer is responsible for calculating the total downtime affecting their services, in order to determine whether the guaranteed service levels have been met.";
        rdf:value tosla:metricComputation;
        tosl:liableParty :customerEnterprisePlan 
    ] ;
    odrl:consequence :customerEnterprisePlanClaim ;
    odrl:consequence :compensation7_5_EnterprisePlan ;
    odrl:consequence :compensation15_EnterprisePlan ;
    odrl:consequence :compensation25_EnterprisePlan .

# Customer Claim
:customerEnterprisePlanClaim a odrl:Duty ;
    dcterms:description "Customer must claim service credits in case Cedalo fails to meet the SLO";
    odrl:assignee :customerEnterprisePlan ;
    odrl:target :serviceEnterprisePlan ; 
    odrl:action [
        a odrl:Action ;
        rdf:value tosl:claim;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval ;
            odrl:operator odrl:eq ;
            odrl:rightOperand :claimWindowAfterMonthEnd
        ] ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:deliveryChannel;
            odrl:operator odrl:eq ;
            odrl:rightOperand "mailto:support@cedalo.com"
        ] ;
    ] ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand :monthlyUptimePercentage ;
        odrl:operator odrl:lt ;
        odrl:rightOperand "99.99"^^xsd:decimal ;
        odrl:unit <http://qudt.org/vocab/unit#Percent>
    ] .

# First level of compensation
:compensation7_5_EnterprisePlan a odrl:Duty ;
    dcterms:description "Compensation to the customer for non-compliance";
    odrl:compensatedParty :customerEnterprisePlan ;
    odrl:compensatingParty :cedalo;
    odrl:assignee :cedalo ;
    odrl:target :serviceEnterprisePlan ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :serviceCreditPercentage;
            odrl:operator odrl:eq ;
            odrl:rightOperand "7.5"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ; 
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:delayPeriod;
            odrl:operator odrl:lteq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ] ;
    ];
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:and (
            [
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentage ;
                odrl:operator odrl:gteq ;
                odrl:rightOperand "98.99"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
            [
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentage ;
                odrl:operator odrl:lt ;
                odrl:rightOperand "99.99"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
        )
    ] .

# Second level of compensation
:compensation15_EnterprisePlan a odrl:Duty ;
    dcterms:description "Compensation to the customer for non-compliance";
    odrl:compensatedParty :customerEnterprisePlan ;
    odrl:compensatingParty :cedalo;
    odrl:assignee :cedalo ;
    odrl:target :serviceEnterprisePlan ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :serviceCreditPercentage;
            odrl:operator odrl:eq ;
            odrl:rightOperand "15"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ; 
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:delayPeriod;
            odrl:operator odrl:lteq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ] ;
    ];
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:and (
            [
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentage ;
                odrl:operator odrl:gteq ;
                odrl:rightOperand "89.99"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]            
            [
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentage ;
                odrl:operator odrl:lt ;
                odrl:rightOperand "98.99"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
        )
    ] .

# Third level of compensation
:compensation25_EnterprisePlan a odrl:Duty ;
    dcterms:description "Compensation Enterprise for non-compliance monthly uptime percentage 89.99";
    odrl:compensatedParty :customerEnterprisePlan ;
    odrl:compensatingParty :cedalo;
    odrl:assignee :cedalo ;
    odrl:target :serviceEnterprisePlan ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :serviceCreditPercentage;
            odrl:operator odrl:eq ;
            odrl:rightOperand "25"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:delayPeriod;
            odrl:operator odrl:lteq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ] ;
    ];
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand :monthlyUptimePercentage ;
        odrl:operator odrl:lt ;
        odrl:rightOperand "89.99"^^xsd:decimal ;
        odrl:unit <http://qudt.org/vocab/unit#Percent>
    ] .


# Permission of maintenance

:maintenancePurpose a odrl:RightOperand ;
    dcterms:description "This purpose refers to the correction of issues, application of patches, and other technical actions required to ensure that the service functions correctly and without errors." .

:permissionMaintenance a odrl:Permission ;
    dcterms:description "Cedalo may perform maintenance if it gives 3 days’ notice" ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:modify;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:purpose;
            odrl:operator odrl:eq ;
            odrl:rightOperand :maintenancePurpose
        ] ;
    ];
    odrl:target :serviceSPlanSingleNode, :serviceSPlanHighAvailability, :serviceMPlanSingleNode, :serviceMPlanHighAvailability, :serviceLPlanSingleNode, :serviceLPlanHighAvailability, :serviceEnterprisePlan ;
    odrl:assignee :cedalo ;
    odrl:duty :serviceChangeNotification .

:serviceChangeNotification a odrl:Duty ;
    dcterms:description "Cedalo will inform the Customer of these maintenance times at least three days in advance in written form.";
    odrl:action odrl:inform ;
    odrl:assignee :cedalo ;
    odrl:target :serviceSPlanSingleNode, :serviceSPlanHighAvailability, :serviceMPlanSingleNode, :serviceMPlanHighAvailability, :serviceLPlanSingleNode, :serviceLPlanHighAvailability, :serviceEnterprisePlan ;
    odrl:informedParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    odrl:informingParty :cedalo ;
    odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "written"^^xsd:string
    ] ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand odrl:delayPeriod ;
        odrl:operator odrl:gteq ;
        odrl:rightOperand "P3D"^^xsd:duration
    ] .


#################################################
# Exclusions, limitations of liabilities 
#################################################

:liabilityCustomerFailure a tosl:Liability ;
    dcterms:description "Service interruptions due to Customer’s failure to perform required corrective actions or provide necessary information." ;
    rdf:value tosla:userContent ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilitySecurityBreach a tosl:Liability ;
    dcterms:description "Unavailability caused by unlawful or non-compliant actions of the Customer or misuse of access credentials." ;
    rdf:value tosla:securityBreach ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilityThirdParty a tosl:Liability ;
    dcterms:description "Issues from third-party services, hardware, or software beyond Cedalo’s control." ;
    rdf:value tosl:thirdParty ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilityBreachContract a tosl:Liability ;
    dcterms:description "Situations where Cedalo suspends access due to violations of the Customer’s obligations." ;
    rdf:value tosl:breachOfContract ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilityForceMajeure a tosl:Liability ;
    dcterms:description "Unavailability due to force majeure, DDoS attacks, or similar events beyond Cedalo’s control." ;
    rdf:value tosl:anyIndirectDamage, tosl:harmCausedByMalware ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilityNetworkInfrastructure a tosl:Liability ;
    dcterms:description "Interruptions in public networks or Internet infrastructure that prevent access to SaaS services." ;
    rdf:value tosla:networkFailure ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilityMaintenanceWindow a tosl:Liability ;
    dcterms:description "Planned maintenance windows up to 4 hours per month" ;
    rdf:value tosla:scheduledMaintenance ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo ;
    tosl:limitation [
        a odrl:constraint ;
        dcterms:description "Maximum of 4 hours of maintenance allowed per full calendar month." ;
        odrl:leftOperand odrl:elapsedTime ;
        odrl:operator odrl:lteq ;
        odrl:rightOperand "PT4H"^^xsd:duration ;
    ] .

:liabilitySelfHosted a tosl:Liability ;
    dcterms:description "Exclusion applies if Cedalo Cloud is not hosted by Cedalo. SLA does not apply in such cases." ;
    rdf:value tosla:selfHosting ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .

:liabilityPaymentDefault a tosl:Liability ;
    dcterms:description "Customers in default of payment are not eligible to claim service credits." ;
    rdf:value tosla:paymentOverdue ;
    tosl:targetParty :customerSPlan, :customerMPlan, :customerLPlan, :customerEnterprisePlan ;
    tosl:liableParty :cedalo .
