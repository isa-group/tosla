# Plan M High Availability Obligation

:commitmentMPlanHighAvailability a odrl:Duty ;
    dcterms:description "Cedalo must provide an uptime percentage of at least 99.5%";
    odrl:target :serviceMPlanHighAvailability ; 
    odrl:assignee :cedalo ; 
    odrl:action [
        a odrl:Action ;
        rdf:value tosla:guarantee;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :monthlyUptimePercentage;
            odrl:operator odrl:gteq ;
            odrl:rightOperand "99.5"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval;
            odrl:operator odrl:eq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ]; 
    ];
    tosl:liability [ 
        a tosl:Liability ;
        dcterms:description "The customer is responsible for monitoring and compiling all information regarding service unavailability in order to claim compensation.";
        rdf:value tosla:conditionEvaluation ;
        tosl:liableParty :customerMPlan 
    ] ;
    tosl:liability [ 
        a tosl:Liability ;     
        dcterms:description "The customer is responsible for calculating the total downtime affecting their services, in order to determine whether the guaranteed service levels have been met.";
        rdf:value tosla:metricComputation;
        tosl:liableParty :customerMPlan 
    ] ;
    odrl:consequence :customerMPlanHighAvailabilityClaim ;
    odrl:consequence :compensation7_5_MPlanHighAvailability ;
    odrl:consequence :compensation15_MPlanHighAvailability ;
    odrl:consequence :compensation25_MPlanHighAvailability .

