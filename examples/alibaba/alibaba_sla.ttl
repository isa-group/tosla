@prefix : <http://example.com/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .   
@prefix time: <http://www.w3.org/2006/time#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix usdl-agreement: <http://www.linked-usdl.org/ns/usdl-agreement#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tosl: <https://w3id.org/tosl/> .
@prefix tosla: <https://w3id.org/tosla/> .
@base <http://example.com> .

#################################################
# Agreement
#################################################

:alibabaECSSLA a odrl:Agreement, odrl:Asset ;
    dcterms:title "Elastic Compute Service (ECS) Service Level Agreement"^^xsd:string ;
    dcterms:creator "Alibaba Cloud"^^xsd:string ;
    dcterms:source <https://www.alibabacloud.com/help/en/legal/latest/elastic-compute-service-service-level-agreement> ;
    dcterms:requires <https://www.alibabacloud.com/help/en/legal/latest/alibaba-cloud-international-website-product-terms-of-service-v-3-8-0> ; 
    dcterms:issued "2023-01-13"^^xsd:date ;
    odrl:permission :slaModificationPermission ;
    odrl:obligation :uptimeCommitmentInstance, :customerClaimInstance, :compensationInstance10, 
                    :compensationInstance25, :compensationInstance100, :uptimeCommitmentMultiZone, 
                    :customerClaimMultiZone, :compensationMultiZone10, :compensationMultiZone25, 
                    :compensationMultiZone100 ;
    tosl:limitationOfLiability :liabilitySuspensionContract, :liabilityForceMajeure, :liabilityCustomerNegligence,
                                 :liabilityThirdPartyTechnology, :liabilityMisconfiguration, :liabilityExternalNetworkFailure,
                                 :liabilityIllegalUse, :liabilityPaymentDefault, :liabilityCriticalISPFailure,
                                 :liabilitySecurityBreach, :liabilityDataLeakage, :liabilityEphemeralDiskLoss;
    odrl:assigner :alibaba .

#################################################
# Parties
#################################################

:alibaba a tosl:Provider ;
    dcterms:description "Alibaba Cloud"^^xsd:string ;
    foaf:name "Alibaba Cloud";
    foaf:homepage <https://www.alibabacloud.com/>;
    odrl:assignerOf :instanceEcsService, :multiZoneEcsService .

:customer a tosl:Customer ;
    dcterms:description "This party represents the consumer in the context of the Elastic Compute Service of Alibaba" .

#################################################
# Assets description
#################################################

:instanceEcsService a tosl:Service ;
    dcterms:description "Alibaba Cloud Elastic Compute Service (ECS) instance offering covered by this SLA." ;
    dcterms:rightsHolder :alibaba .

:multiZoneEcsService a tosl:Service ;
    dcterms:description "Alibaba Cloud ECS instances deployed in multiple zones within the same region, subject to higher uptime SLA." ;
    dcterms:rightsHolder :alibaba .

#################################################
# Properties 
#################################################

:monthlyUptimePercentageInstanceUnavailable a odrl:LeftOperand ;
    rdfs:label "Instance Monthly Uptime Percentage"@en ;
    dcterms:description "Percentage availability per ECS instance in the month." ;
    usdl-agreement:hasMetric :monthlyUptimeMetric .

:monthlyUptimePercentageMultiZoneUnavailable a odrl:LeftOperand ;
    rdfs:label "Multi-zone Monthly Uptime Percentage"@en ;
    dcterms:description "Availability for ECS multi-zone deployments." ;
    usdl-agreement:hasMetric :monthlyUptimeMetric .

:monthlyUptimeMetric a usdl-agreement:Metric ;
    qudt:unit <http://qudt.org/vocab/unit#Percent> ;
    usdl-agreement:hasExpression "100 * ((?serviceCycleMinutes - ?downtimeMinutes) / ?serviceCycleMinutes)"^^xsd:string ;
    usdl-agreement:hasMeasuringInterval :monthlyInterval .

:monthlyInterval a time:Interval ;
    time:hasDurationDescription [
        a time:DurationDescription ;
        time:months "1"^^xsd:integer
    ] .

:serviceCreditPercentage a odrl:LeftOperand ;
    rdfs:label "Service Credit Percentage"@en ;
    dcterms:description "Percentage of the Monthly Service Fee to credit." .


:serviceCredit a odrl:Asset ;
    rdfs:label "Service Credit"@en ;
    dcterms:description "A monetary credit applied to the Customer’s account as compensation for non-compliance with the Service Level Agreement." .

#################################################
# Obligations, permission and prohibition 
#################################################

:claimWindow a time:Interval ;
    dcterms:description "55-day claim submission window starting from the 6th working day of the month following the month when the incident occurred." ;
    rdfs:comment "IMPORTANT: The start date must be computed dynamically as the 6th working day (business day). This is not simply the 6th calendar day." ;
    time:hasBeginning :claimWindowStartDate ;
    time:hasDurationDescription [
        a time:DurationDescription ;
        dcterms:description "Duration of 55 days from the computed start date." ;
        time:days "55"^^xsd:integer
    ] .

:claimWindowStartDate a time:DateTimeDescription ;
    dcterms:description "The 6th working day of the following month, dynamically computed per incident." .


# Uptime Commitment Instance

:uptimeCommitmentInstance a odrl:Duty ;
    dcterms:description "Alibaba must provide at least 99.975% uptime per instance." ;
    odrl:assignee :alibaba ;
    odrl:target :instanceEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value tosla:guarantee;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ;
            odrl:operator odrl:gteq ;
            odrl:rightOperand "99.975"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval;
            odrl:operator odrl:eq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ]; 
    ];
    tosl:liability [ 
        a tosl:Liability ;
        dcterms:description "The customer is responsible for monitoring and compiling all information regarding service unavailability in order to claim compensation.";
        rdf:value tosla:conditionEvaluation ;
        tosl:liableParty :customer 
    ] ;
    tosl:liability [ 
        a tosl:Liability ;     
        dcterms:description "The customer is responsible for calculating the total downtime affecting their services, in order to determine whether the guaranteed service levels have been met.";
        rdf:value tosla:metricComputation;
        tosl:liableParty :customer 
        
    ] ;
    odrl:consequence :customerClaimInstance ;
    odrl:consequence :compensationInstance10 ;
    odrl:consequence :compensationInstance25 ;
    odrl:consequence :compensationInstance100 .

:customerClaimInstance a odrl:Duty ;
    dcterms:description "Customer must submit the claim within the defined time window." ;
    odrl:assignee :customer ;
    odrl:target :instanceEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value tosl:claim ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval ;
            odrl:operator odrl:eq ;
            odrl:rightOperand :claimWindow
        ] ;
    ] ;
    odrl:constraint [
        odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ;
        odrl:operator odrl:lt ;
        odrl:rightOperand "99.975"^^xsd:decimal ;
        odrl:unit <http://qudt.org/vocab/unit#Percent>
    ] .    
    
:compensationInstance10 a odrl:Duty ;
    dcterms:description "10% credit if instance uptime <99.975% but ≥99%." ;
    odrl:compensatedParty :customer ;
    odrl:compensatingParty :alibaba ;
    odrl:assignee :alibaba ;
    odrl:target :instanceEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            a odrl:Constraint ;
            odrl:leftOperand :serviceCreditPercentage ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "10"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
    ];
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:and (
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ; 
                odrl:operator odrl:gteq ; 
                odrl:rightOperand "99.0"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ; 
                odrl:operator odrl:lt ; 
                odrl:rightOperand "99.975"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
        )
    ] .

:compensationInstance25 a odrl:Duty ;
    dcterms:description "25% credit if uptime <99% but ≥95%." ;
    odrl:compensatedParty :customer ;
    odrl:compensatingParty :alibaba ;
    odrl:assignee :alibaba ;
    odrl:target :instanceEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            odrl:leftOperand :serviceCreditPercentage ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "25"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
    ];
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:and (
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ; 
                odrl:operator odrl:gteq ; 
                odrl:rightOperand "95.0"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]            
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ; 
                odrl:operator odrl:lt ; 
                odrl:rightOperand "99.0"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
        )
    ] .

:compensationInstance100 a odrl:Duty ;
    dcterms:description "100% credit if uptime <95%." ;
    odrl:compensatedParty :customer ;
    odrl:compensatingParty :alibaba ;
    odrl:assignee :alibaba ;
    odrl:target :instanceEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            odrl:leftOperand :serviceCreditPercentage ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "100"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
    ] ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand :monthlyUptimePercentageInstanceUnavailable ; 
        odrl:operator odrl:lt ; 
        odrl:rightOperand "95.0"^^xsd:decimal ;
        odrl:unit <http://qudt.org/vocab/unit#Percent>
    ] .

# Uptime Commitment Multi-Zone

:uptimeCommitmentMultiZone a odrl:Duty ;
    dcterms:description "Alibaba must provide at least 99.995% uptime for multi-zone deployments." ;
    odrl:assignee :alibaba ;
    odrl:target :multiZoneEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value tosla:guarantee;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ;
            odrl:operator odrl:gteq ;
            odrl:rightOperand "99.995"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval;
            odrl:operator odrl:eq ;
            odrl:rightOperand "P30D"^^xsd:duration
        ]; 
    ];
    tosl:liability [ 
        a tosl:Liability ;
        dcterms:description "The customer is responsible for monitoring and compiling all information regarding service unavailability in order to claim compensation.";
        rdf:value tosla:conditionEvaluation ;
        tosl:liableParty :customer 
    ] ;
    tosl:liability [ 
        a tosl:Liability ;     
        dcterms:description "The customer is responsible for calculating the total downtime affecting their services, in order to determine whether the guaranteed service levels have been met.";
        rdf:value tosla:metricComputation;
        tosl:liableParty :customer 
    ] ;
    odrl:consequence :customerClaimMultiZone ;
    odrl:consequence :compensationMultiZone10 ;
    odrl:consequence :compensationMultiZone25 ;
    odrl:consequence :compensationMultiZone100 .

:customerClaimMultiZone a odrl:Duty ;
    dcterms:description "Customer must submit the claim within the defined time window." ;
    odrl:assignee :customer ;
    odrl:target :multiZoneEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value tosl:claim ;
        odrl:refinement [
            a odrl:Constraint;
            odrl:leftOperand odrl:timeInterval ;
            odrl:operator odrl:eq ;
            odrl:rightOperand :claimWindow
        ] ;
    ] ;
    odrl:constraint [
        odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ;
        odrl:operator odrl:lt ;
        odrl:rightOperand "99.995"^^xsd:decimal ;
        odrl:unit <http://qudt.org/vocab/unit#Percent>
    ] .    
    
:compensationMultiZone10 a odrl:Duty ;
    dcterms:description "10% credit if instance uptime <99.995% but ≥99%." ;
    odrl:compensatedParty :customer ;
    odrl:compensatingParty :alibaba ;
    odrl:assignee :alibaba ;
    odrl:target :multiZoneEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;
        odrl:refinement [
            a odrl:Constraint ;
            odrl:leftOperand :serviceCreditPercentage ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "10"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
    ] ;
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:and (
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ; 
                odrl:operator odrl:gteq ; 
                odrl:rightOperand "99.0"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ; 
                odrl:operator odrl:lt ; 
                odrl:rightOperand "99.995"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
        )
    ] .

:compensationMultiZone25 a odrl:Duty ;
    dcterms:description "25% credit if uptime <99% but ≥95%." ;
    odrl:compensatedParty :customer ;
    odrl:compensatingParty :alibaba ;
    odrl:assignee :alibaba ;
    odrl:target :multiZoneEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;    
        odrl:refinement [
            odrl:leftOperand :serviceCreditPercentage ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "25"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
    ] ;
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:and (
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ; 
                odrl:operator odrl:gteq ; 
                odrl:rightOperand "95.0"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]            
            [ 
                a odrl:Constraint ;
                odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ; 
                odrl:operator odrl:lt ; 
                odrl:rightOperand "99.0"^^xsd:decimal ;
                odrl:unit <http://qudt.org/vocab/unit#Percent>
            ]
        )
    ] .

:compensationMultiZone100 a odrl:Duty ;
    dcterms:description "100% credit if uptime <95%." ;
    odrl:compensatedParty :customer ;
    odrl:compensatingParty :alibaba ;
    odrl:assignee :alibaba ;
    odrl:target :multiZoneEcsService ;
    odrl:action [
        a odrl:Action ;
        rdf:value odrl:compensate;  
        odrl:refinement [
            odrl:leftOperand :serviceCreditPercentage ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "100"^^xsd:decimal ;
            odrl:unit <http://qudt.org/vocab/unit#Percent>
        ] ;
    ] ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand :monthlyUptimePercentageMultiZoneUnavailable ; 
        odrl:operator odrl:lt ; 
        odrl:rightOperand "95.0"^^xsd:decimal ;
        odrl:unit <http://qudt.org/vocab/unit#Percent>
    ] .


:creditUsageWindow a time:Interval ;
  dcterms:description "Service Credit must be used within 2 months." ;
  time:hasDurationDescription [ 
    a time:DurationDescription ;
    time:months "2"^^xsd:integer
  ] .

:customerCreditUsageInterval a odrl:Duty ;
    dcterms:description "Customer must apply the Service Credit within 2 months of issuance." ;
    odrl:assignee :customer ;
    odrl:action odrl:use ;
    odrl:target :serviceCredit;
    odrl:constraint [
        odrl:leftOperand odrl:timeInterval ;
        odrl:operator odrl:eq ;
        odrl:rightOperand :creditUsageWindow
    ] ;
    odrl:constraint [
        a odrl:LogicalConstraint ;
        odrl:or (
            [ 
                a odrl:Constraint ;
                odrl:leftOperand odrl:product ;
                odrl:operator odrl:eq ;
                odrl:rightOperand :instanceEcsService
            ]
            [ 
                a odrl:Constraint ;
                odrl:leftOperand odrl:product ;
                odrl:operator odrl:eq ;
                odrl:rightOperand :multiZoneEcsService
            ]
        )
    ] .


# Change the terms

:slaModificationPermission a odrl:Permission ;
    dcterms:description "Alibaba reserves the right to unilaterally modify the terms of this SLA by posting an amended version on the Alibaba Cloud website. Continued use of the Service shall be deemed acceptance." ;
    odrl:action odrl:modify ;
    odrl:target :alibabaECSSLA ;
    odrl:assignee :alibaba ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand tosl:consentType ;
        odrl:operator odrl:eq ;
        odrl:rightOperand tosl:implicitConsent
    ];
    tosl:trigger :publishAgreement .

:publishAgreement a odrl:Duty ;
    dcterms:description "Alibaba must publish the amended SLA version on its website." ;
    odrl:action tosl:publish ; 
    odrl:target :alibabaECSSLA ;
    odrl:assignee :alibaba ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand odrl:deliveryChannel ;
        odrl:operator odrl:eq ;
        odrl:rightOperand "https://www.alibabacloud.com/help/en/legal/latest/elastic-compute-service-service-level-agreement"
    ] .

#################################################
# Exclusions, limitations of liabilities 
#################################################

:liabilitySuspensionContract a tosl:Liability ;
    dcterms:description "Suspension or termination of ECS Service due to breach of Alibaba Cloud terms by the Customer." ;
    rdf:value tosl:breachOfContract  ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityForceMajeure a tosl:Liability ;
    dcterms:description "Unavailability due to force majeure events beyond Alibaba Cloud's reasonable control, including earthquakes, submarine cable downtime, and Acts of God." ;
    rdf:value tosl:forceMajeure ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityCustomerNegligence a tosl:Liability ;
    dcterms:description "Unavailability resulting from Customer's actions or omissions, including negligence or unauthorized operations." ;
    rdf:value tosla:userContent ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityThirdPartyTechnology a tosl:Liability ;
    dcterms:description "Unavailability arising from third-party equipment, software or configurations not controlled by Alibaba Cloud." ;
    rdf:value tosl:thirdParty, tosla:networkFailure ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityMisconfiguration a tosl:Liability ;
    dcterms:description "Unavailability resulting from Customer's failure to adhere to required configurations." ;
    rdf:value tosla:userContent ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityExternalNetworkFailure a tosl:Liability ;
    dcterms:description "Events arising from failures or configuration changes in networks or equipment not belonging to Alibaba Cloud." ;
    rdf:value tosl:thirdParty ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityIllegalUse a tosl:Liability ;
    dcterms:description "Unavailability caused by illegal or unlawful use of the Service, or breach of Alibaba Cloud terms and conditions." ;
    rdf:value tosl:breachOfContract ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityPaymentDefault a tosl:Liability ;
    dcterms:description "Unavailability or suspension due to Customer's failure to pay charges owed." ;
    rdf:value tosla:paymentOverdue ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityCriticalISPFailure a tosl:Liability ;
    dcterms:description "Events resulting from critical accidents or failures of relevant internet service providers or scheduled maintenance." ;
    rdf:value tosl:thirdParty, tosl:anyIndirectDamage, tosla:scheduledMaintenance ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilitySecurityBreach a tosl:Liability ;
    dcterms:description "Events resulting from hacking of Customer applications." ;
    rdf:value tosla:securityBreach ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityDataLeakage a tosl:Liability ;
    dcterms:description "Events resulting from loss or leakage of data, tokens, passwords, or ssh keys due to inadequate maintenance by Customer." ;
    rdf:value tosla:userContent ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .

:liabilityEphemeralDiskLoss a tosl:Liability ;
    dcterms:description "Events resulting from loss of data stored in ephemeral or local disks following critical failures of the host." ;
    rdf:value tosl:anyLoss ;
    tosl:targetParty :customer ;
    tosl:liableParty :alibaba .